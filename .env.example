# ─── Database ──────────────────────────────────────────────
# PostgreSQL connection string used by BOTH the app and drizzle-kit
# migrations. Required.
DATABASE_URL=postgresql://user:password@localhost:5432/voting_db

# ─── Authentication ────────────────────────────────────────
# Secret used to HMAC-sign the session cookie. Minimum 32 random
# characters. Generate with: openssl rand -hex 32
SESSION_SECRET=generate-a-random-secret-at-least-32-chars

# Session lifetime in hours. Default: 8
SESSION_MAX_AGE_HOURS=8

# ─── Seeding ───────────────────────────────────────────────
# Allows `npm run db:seed` to create the Northfield demo dataset.
# The seed script REFUSES to run when NODE_ENV=production unless this
# is explicitly "true". Never enable in production.
SEED_DEMO=false

# ─── Application ───────────────────────────────────────────
# Set automatically by Next.js / the platform in production. Only set
# manually for local builds if you know you need to.
NODE_ENV=development

# Shows demo credentials on the login page. Development only.
NEXT_PUBLIC_DEMO_MODE=false
